---
import type { GetStaticPaths } from "astro";
import ProjectCard from "@/components/projects/ProjectCard.astro";
import { getLocalizedProjects } from "@/data/projects";
import { defaultTechColor, techColors } from "@/data/techColors";
import { isLocale, type Locale, locales } from "@/i18n/config";
import { useTranslations } from "@/i18n/utils";
import PageLayout from "@/layouts/Base.astro";

export const getStaticPaths = (() => {
	return locales.map((lang) => ({ params: { lang } }));
}) satisfies GetStaticPaths;

const { lang } = Astro.params;
if (!isLocale(lang)) throw new Error(`Invalid locale: ${lang}`);
const locale: Locale = lang;
const t = useTranslations(locale);
const projects = getLocalizedProjects(locale);

const uniqueTechs = [...new Set(projects.flatMap((p) => p.tech))].sort((a, b) =>
	a.localeCompare(b),
);

const meta = {
	description: t("projects.pageDescription"),
	title: t("projects.title"),
};
---

<PageLayout meta={meta} locale={locale}>
	<h1 class="title mb-4">{t("projects.title")}</h1>
	<p class="mb-6 text-sm">{t("projects.intro")}</p>

	<div class="mb-6">
		<h2 class="sr-only">{t("projects.filterByTech")}</h2>
		<ul class="flex flex-wrap gap-1.5" id="tech-filter-list" role="list">
			{
				uniqueTechs.map((tech) => {
					const color = techColors[tech] ?? defaultTechColor;
					return (
						<li>
							<button
								aria-pressed="false"
								class="tech-filter-btn border-accent-2/20 cursor-pointer rounded border px-1.5 py-0.5 text-[11px] font-medium transition-colors duration-150"
								data-tech={tech}
								style={`--pill-bg: ${color.bg}; --pill-text: ${color.text};`}
								type="button"
							>
								{tech}
							</button>
						</li>
					);
				})
			}
		</ul>
	</div>

	<div
		class="border-accent-2/20 mb-6 flex items-center gap-2 rounded border border-dashed px-3 py-2 text-xs"
		hidden
		id="project-filter-banner"
	>
		<span>{t("projects.filterBy")}</span>
		<span class="text-accent-2 font-semibold" id="project-filter-label"></span>
		<span class="text-gray-600 dark:text-gray-400" id="project-filter-count"></span>
		<button class="cactus-link ml-auto" id="project-filter-clear" type="button">
			{t("projects.clearFilter")}
		</button>
	</div>

	<div
		class="grid gap-4 sm:grid-cols-2"
		id="projects-grid"
		data-of={t("projects.ofProjects")}
		data-projects={t("projects.projects")}
	>
		{projects.map((project) => <ProjectCard project={project} />)}
	</div>
</PageLayout>

<style>
	.tech-filter-btn:hover,
	.tech-filter-btn[aria-pressed="true"] {
		background-color: var(--pill-bg);
		color: var(--pill-text);
		border-color: var(--pill-bg);
	}
</style>

<script>
	const banner = document.getElementById("project-filter-banner");
	const label = document.getElementById("project-filter-label");
	const count = document.getElementById("project-filter-count");
	const clearBtn = document.getElementById("project-filter-clear");
	const grid = document.getElementById("projects-grid");
	const filterButtons = Array.from(document.querySelectorAll<HTMLButtonElement>(".tech-filter-btn"));

	if (banner && label && count && clearBtn && grid) {
		const ofWord = grid.dataset.of ?? "of";
		const projectsWord = grid.dataset.projects ?? "projects";
		let activeFilter: string | null = null;
		const articles = Array.from(grid.querySelectorAll<HTMLElement>("article"));
		const badges = Array.from(grid.querySelectorAll<HTMLElement>(".tech-badge"));

		const articleTechs = (article: HTMLElement) => (article.dataset.techs ?? "").split(",");

		const applyFilter = (tech: string | null) => {
			activeFilter = tech;
			let visible = 0;

			for (const article of articles) {
				const matches = !tech || articleTechs(article).includes(tech);
				article.hidden = !matches;
				if (matches) visible += 1;
			}

			for (const button of filterButtons) {
				button.setAttribute("aria-pressed", String(button.dataset.tech === tech));
			}

			for (const badge of badges) {
				badge.toggleAttribute("data-active", badge.dataset.tech === tech);
			}

			banner.hidden = !tech;
			if (tech) {
				label.textContent = tech;
				count.textContent = `· ${visible} ${ofWord} ${articles.length} ${projectsWord}`;
			}
		};

		for (const button of filterButtons) {
			button.addEventListener("click", () => {
				const tech = button.dataset.tech ?? null;
				applyFilter(activeFilter === tech ? null : tech);
			});
		}

		clearBtn.addEventListener("click", () => applyFilter(null));
	}
</script>
