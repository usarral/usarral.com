---
import { Icon } from "astro-icon/components";
import type { LocalizedProject } from "@/data/projects";
import { defaultTechColor, techColors } from "@/data/techColors";

interface Props {
	project: LocalizedProject;
}

const { project } = Astro.props;
const primaryLink = project.links?.[0];
---

<article
	class={`border-accent-2/15 group flex flex-col gap-3 rounded-md border border-dashed p-4 transition-colors${primaryLink ? " hover:border-accent/60" : ""}`}
	data-techs={project.tech.join(",")}
>
	<header class="flex flex-col gap-1">
		<h2 class="text-accent-2 text-base font-semibold">
			{
				primaryLink ? (
					<a
						class="group-hover:text-accent transition-colors"
						href={primaryLink.href}
						rel="noreferrer"
						target="_blank"
					>
						{project.name}
					</a>
				) : (
					project.name
				)
			}
		</h2>
		<p class="text-xs text-gray-600 dark:text-gray-400">{project.summary}</p>
	</header>

	<p class="text-sm leading-relaxed">{project.description}</p>

	{
		project.tech.length > 0 && (
			<ul class="flex flex-wrap gap-1.5" role="list">
				{project.tech.map((t) => {
					const color = techColors[t] ?? defaultTechColor;
					return (
						<li>
							<span
								class="tech-badge border-accent-2/20 rounded border px-1.5 py-0.5 text-[11px] font-medium transition-colors duration-150"
								data-tech={t}
								style={`--pill-bg: ${color.bg}; --pill-text: ${color.text};`}
							>
								{t}
							</span>
						</li>
					);
				})}
			</ul>
		)
	}

	{
		project.links && project.links.length > 0 && (
			<ul class="mt-auto flex flex-wrap gap-x-4 gap-y-1 pt-1" role="list">
				{project.links.map((link) => (
					<li>
						<a
							class="cactus-link inline-flex items-center gap-1 text-xs"
							href={link.href}
							rel="noreferrer"
							target="_blank"
						>
							<Icon
								aria-hidden="true"
								class="h-3.5 w-3.5"
								focusable="false"
								name="mdi:open-in-new"
							/>
							{link.label}
						</a>
					</li>
				))}
			</ul>
		)
	}
</article>

<style>
	.tech-badge[data-active] {
		background-color: var(--pill-bg);
		color: var(--pill-text);
		border-color: var(--pill-bg);
	}
</style>
